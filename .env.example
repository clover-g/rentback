# Client (baked into the static build)
NEXT_PUBLIC_RPC_URL=https://your-rpc.example.com/?api-key=YOUR_KEY
NEXT_PUBLIC_CLUSTER=mainnet-beta
NEXT_PUBLIC_FEE_WALLET=YOUR_FEE_WALLET_ADDRESS
NEXT_PUBLIC_FEATURE_STATS=false

# Worker secrets (set with `npx wrangler secret put NAME`, not in this file)
# ADMIN_PASSWORD=
# ADMIN_RPC_URL=
